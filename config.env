# === THÔNG TIN KERNEL XIAOMI PAD 7 ===
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource.git
KERNEL_SOURCE_BRANCH=uke-u-oss
KERNEL_CONFIG=uke_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb

# === BẬT KernelSU-Next + SUSFS ===
KERNELSU_NEXT=true
SUSFS=true
SUSFS_BRANCH=gki-android14-6.1

# === Tùy chọn ===
EXTRA_CMDS=""
